# ============================================================================
# Vaultwarden Server Configuration
# ============================================================================
DOMAIN=https://bitwarden.shampadsr.com
SIGNUPS_ALLOWED=false
WEBSOCKET_ENABLED=true
IP_HEADER=X-Real-IP

# ============================================================================
# Backup & GCS Sync Configuration
# ============================================================================
VAULTWARDEN_DATA_DIR=/home/shampad/bitwarden-data/vaultwarden
VAULTWARDEN_BACKUP_DIR=/home/shampad/Desktop/projects/bitwarden-password-manager/backups
VAULTWARDEN_RETENTION_DAYS=7
VAULTWARDEN_ARCHIVE_ENABLED=true
VAULTWARDEN_ARCHIVE_PREFIX=vaultwarden-data
VAULTWARDEN_ARCHIVE_EXCLUDES=backups:tmp:icon_cache

GCS_BUCKET_NAME=home-server-ss
GCS_BUCKET_PATH=bitwarden-backups
GCS_RETENTION_DAYS=30
GCS_MONTHLY_RETENTION_MONTHS=12
GCS_SERVICE_ACCOUNT_KEY=/home/shampad/Desktop/projects/bitwarden-password-manager/env/service_account.json

# ============================================================================
# Telegram Notification Configuration
# ============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

